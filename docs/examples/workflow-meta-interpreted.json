{
  "dsl_version": "0.1",
  "name": "Registrar solicitud empresarial",
  "description": "El operador ingresa al Portal Andina Servicios con sus credenciales, accede a la opción de nueva solicitud y registra una solicitud empresarial indicando cliente, correo, categoría, prioridad media y descripción, con notificación por correo activada, hasta obtener la confirmación de registro.",
  "adapter": "web",
  "allowed_origins": [
    "http://localhost:8080"
  ],
  "inputs": [
    {
      "name": "usuario",
      "label": "Usuario",
      "sensitive": false,
      "default": null
    },
    {
      "name": "contrasena",
      "label": "Contraseña",
      "sensitive": true,
      "default": null
    },
    {
      "name": "nombre_del_cliente",
      "label": "Nombre del cliente",
      "sensitive": false,
      "default": null
    },
    {
      "name": "correo_del_cliente",
      "label": "Correo del cliente",
      "sensitive": false,
      "default": null
    },
    {
      "name": "categoria",
      "label": "Categoría",
      "sensitive": false,
      "default": null
    },
    {
      "name": "descripcion",
      "label": "Descripción",
      "sensitive": false,
      "default": null
    }
  ],
  "steps": [
    {
      "id": "s1",
      "description": "Iniciar el acceso al portal de ingreso.",
      "action": "navigate",
      "url": "http://localhost:8080/index.html"
    },
    {
      "id": "s2",
      "description": "Aportar la identidad del operador.",
      "action": "fill",
      "target": {
        "description": "textbox \"Usuario\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "login-username"
          },
          {
            "by": "role",
            "role": "textbox",
            "name": "Usuario"
          },
          {
            "by": "label",
            "value": "Usuario"
          },
          {
            "by": "css",
            "value": "#username"
          },
          {
            "by": "css",
            "value": "input[name=\"username\"]"
          }
        ]
      },
      "value": "{{inputs.usuario}}"
    },
    {
      "id": "s3",
      "description": "Aportar la clave de acceso del operador.",
      "action": "fill",
      "target": {
        "description": "input \"Contraseña\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "login-password"
          },
          {
            "by": "label",
            "value": "Contraseña"
          },
          {
            "by": "css",
            "value": "#password"
          },
          {
            "by": "css",
            "value": "input[name=\"password\"]"
          }
        ]
      },
      "value": "{{inputs.contrasena}}"
    },
    {
      "id": "s4",
      "description": "Validar credenciales e ingresar al sistema.",
      "action": "click",
      "target": {
        "description": "button \"Ingresar\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "login-submit"
          },
          {
            "by": "role",
            "role": "button",
            "name": "Ingresar"
          },
          {
            "by": "text",
            "value": "Ingresar"
          },
          {
            "by": "css",
            "value": "#login-form > button:nth-of-type(1)"
          }
        ]
      }
    },
    {
      "id": "s5",
      "description": "Esperar la carga del panel principal.",
      "action": "wait_for_url",
      "path": "/dashboard.html"
    },
    {
      "id": "s6",
      "description": "Iniciar la creación de una nueva solicitud.",
      "action": "click",
      "target": {
        "description": "link \"Nueva solicitud\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "nav-new-request"
          },
          {
            "by": "role",
            "role": "link",
            "name": "Nueva solicitud"
          },
          {
            "by": "text",
            "value": "Nueva solicitud"
          },
          {
            "by": "css",
            "value": "body > main:nth-of-type(1) > nav:nth-of-type(1) > a:nth-of-type(1)"
          }
        ]
      }
    },
    {
      "id": "s7",
      "description": "Esperar la carga del formulario de solicitud.",
      "action": "wait_for_url",
      "path": "/new-request.html"
    },
    {
      "id": "s8",
      "description": "Indicar el cliente beneficiario de la solicitud.",
      "action": "fill",
      "target": {
        "description": "textbox \"Nombre del cliente\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "customer-name"
          },
          {
            "by": "role",
            "role": "textbox",
            "name": "Nombre del cliente"
          },
          {
            "by": "label",
            "value": "Nombre del cliente"
          },
          {
            "by": "css",
            "value": "#customer-name"
          },
          {
            "by": "css",
            "value": "input[name=\"customer_name\"]"
          }
        ]
      },
      "value": "{{inputs.nombre_del_cliente}}"
    },
    {
      "id": "s9",
      "description": "Indicar el correo de contacto del cliente.",
      "action": "fill",
      "target": {
        "description": "textbox \"Correo del cliente\"",
        "strategies": [
          {
            "by": "role",
            "role": "textbox",
            "name": "Correo del cliente"
          },
          {
            "by": "label",
            "value": "Correo del cliente"
          },
          {
            "by": "placeholder",
            "value": "cliente@ejemplo.test"
          },
          {
            "by": "css",
            "value": "#customer-email"
          },
          {
            "by": "css",
            "value": "input[name=\"customer_email\"]"
          }
        ]
      },
      "value": "{{inputs.correo_del_cliente}}"
    },
    {
      "id": "s10",
      "description": "Clasificar la solicitud por categoría.",
      "action": "select",
      "target": {
        "description": "combobox \"Categoría\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "category"
          },
          {
            "by": "role",
            "role": "combobox",
            "name": "Categoría"
          },
          {
            "by": "label",
            "value": "Categoría"
          },
          {
            "by": "css",
            "value": "#category"
          },
          {
            "by": "css",
            "value": "select[name=\"category\"]"
          }
        ]
      },
      "value": "{{inputs.categoria}}"
    },
    {
      "id": "s11",
      "description": "Asignar prioridad media a la solicitud.",
      "action": "check",
      "target": {
        "description": "radio \"Media\"",
        "strategies": [
          {
            "by": "role",
            "role": "radio",
            "name": "Media"
          },
          {
            "by": "label",
            "value": "Media"
          },
          {
            "by": "css",
            "value": "input[name=\"priority\"][value=\"media\"]"
          },
          {
            "by": "css",
            "value": "#request-form > fieldset:nth-of-type(1) > label:nth-of-type(2) > input:nth-of-type(1)"
          }
        ]
      },
      "checked": true
    },
    {
      "id": "s12",
      "description": "Detallar el motivo de la solicitud.",
      "action": "fill",
      "target": {
        "description": "textbox \"Descripción\"",
        "strategies": [
          {
            "by": "role",
            "role": "textbox",
            "name": "Descripción"
          },
          {
            "by": "label",
            "value": "Descripción"
          },
          {
            "by": "css",
            "value": "#description"
          },
          {
            "by": "css",
            "value": "textarea[name=\"description\"]"
          }
        ]
      },
      "value": "{{inputs.descripcion}}"
    },
    {
      "id": "s13",
      "description": "Activar la notificación por correo al cliente.",
      "action": "check",
      "target": {
        "description": "checkbox \"Notificar al cliente por correo\"",
        "strategies": [
          {
            "by": "role",
            "role": "checkbox",
            "name": "Notificar al cliente por correo"
          },
          {
            "by": "label",
            "value": "Notificar al cliente por correo"
          },
          {
            "by": "css",
            "value": "#notify"
          },
          {
            "by": "css",
            "value": "input[name=\"notify\"]"
          }
        ]
      },
      "checked": true
    },
    {
      "id": "s14",
      "description": "Confirmar y crear la solicitud empresarial.",
      "action": "click",
      "target": {
        "description": "button \"Crear solicitud\"",
        "strategies": [
          {
            "by": "test_id",
            "value": "submit-request"
          },
          {
            "by": "role",
            "role": "button",
            "name": "Crear solicitud"
          },
          {
            "by": "css",
            "value": "#submit-request"
          },
          {
            "by": "text",
            "value": "Crear solicitud"
          }
        ]
      }
    },
    {
      "id": "s15",
      "description": "Esperar la pantalla de confirmación del registro.",
      "action": "wait_for_url",
      "path": "/confirmation.html"
    }
  ],
  "verify": [
    {
      "type": "text_visible",
      "text": "Solicitud registrada correctamente"
    },
    {
      "type": "url_path",
      "path": "/confirmation.html"
    }
  ],
  "interpretation": {
    "provider": "meta",
    "model": "muse-spark-1.3",
    "generated_at": "2026-10-27T16:04:10.641142Z",
