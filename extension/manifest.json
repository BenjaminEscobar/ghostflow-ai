{
  "manifest_version": 3,
  "name": "GhostFlow Recorder",
  "version": "0.1.0",
  "description": "Graba acciones semánticas en aplicaciones web autorizadas y las envía a GhostFlow AI.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GhostFlow Recorder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "js": ["config.js", "shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
