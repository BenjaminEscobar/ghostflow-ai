# Copia este archivo a .env (nunca subas .env a Git).

# Contraseña de la base PostgreSQL local de Docker Compose. Solo alfanumérica.
POSTGRES_PASSWORD=cambia-esto-solo-local

# Proveedor de IA: "mock" (por defecto, sin red ni costos) o "meta" (Meta Model API).
GHOSTFLOW_AI_PROVIDER=mock

# Solo para misiones posteriores. No configurar en GF-001 (no consumir créditos).
# GHOSTFLOW_META_API_KEY=
# GHOSTFLOW_META_API_BASE_URL=https://api.llama.com/compat/v1
# GHOSTFLOW_META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
