# Copia este archivo a .env (nunca subas .env a Git).
#   - Docker Compose lee ./.env
#   - `make backend` (uvicorn desde backend/) lee backend/.env o las variables exportadas

# Contraseña de la base PostgreSQL local de Docker Compose. Solo alfanumérica.
POSTGRES_PASSWORD=cambia-esto-solo-local

# Proveedor de IA: "mock" (por defecto, offline, sin costos) o "meta" (Meta Model API / Muse Spark).
GHOSTFLOW_AI_PROVIDER=mock

# --- Meta Model API (solo si GHOSTFLOW_AI_PROVIDER=meta) -------------------------------
# La clave vive solo en el backend; nunca en la extensión ni en Git.
# GHOSTFLOW_META_API_KEY=
# GHOSTFLOW_META_API_BASE_URL=https://api.meta.ai/v1
# Modo Standard: Meta no entrena con los datos. Los modelos "-contributor" se rechazan
# salvo GHOSTFLOW_META_ALLOW_CONTRIBUTOR_MODE=true (requiere autorización explícita).
# GHOSTFLOW_META_MODEL=muse-spark-1.3
# GHOSTFLOW_META_TIMEOUT_S=60
# Tope de tokens (razonamiento + salida) por llamada:
# GHOSTFLOW_META_MAX_OUTPUT_TOKENS=4000
# GHOSTFLOW_META_REASONING_EFFORT=low
# Reintentos solo para 429/500/503:
# GHOSTFLOW_META_MAX_RETRIES=1
# Tope duro de peticiones a Meta por proceso del backend:
# GHOSTFLOW_META_MAX_REQUESTS=50
